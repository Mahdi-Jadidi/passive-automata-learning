def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def emit(value) -> None:
    sys.stdout.write(json.dumps(value, ensure_ascii=False, sort_keys=True,
                                 separators=(",", ":")) + "\n")
    sys.stdout.flush()


def canonical(blocks):
    return tuple(sorted(tuple(sorted(block)) for block in blocks))


def project(word: str, block) -> str:
    members = set(block)
    return "".join(ch for ch in word if ch in members)


def partitions(alphabet, k):
    alphabet = sorted(alphabet)
    if not alphabet or not 1 <= k <= len(alphabet):
        return
    labels = [0]

    def visit(highest):
        pos = len(labels)
        if pos == len(alphabet):
            if highest + 1 == k:
                yield [[a for a, label in zip(alphabet, labels) if label == side]
                       for side in range(k)]
            return
        for side in range(min(highest + 1, k - 1) + 1):
            labels.append(side)
            yield from visit(max(highest, side))
            labels.pop()

    yield from visit(0)


def oracle(data, k, q=None):
    positives = sorted(set(data["positive"]))
    negatives = sorted(set(data["negative"]))
    answers = []
    for blocks in partitions(data["alphabet"], k):
        languages = [{project(word, block) for word in positives} for block in blocks]
        if q is not None and any(len(language) > q for language in languages):
            continue
        if any(all(project(word, block) in language
                   for block, language in zip(blocks, languages)) for word in negatives):
            continue
        answers.append(canonical(blocks))
    return sorted(answers)


def unknown_singleton_oracle(data):
    if not data["positive"]:
        return None
    answers = []
    for k in range(1, len(data["alphabet"]) + 1):
        answers.extend(oracle(data, k, q=1))
    return sorted(set(answers))


def load_module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


